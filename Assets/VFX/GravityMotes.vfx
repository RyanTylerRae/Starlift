  m_BlockName: Custom HLSL
  m_HLSLCode: "void ApplyGravityField(inout VFXAttributes attributes, in float3 fieldSampleRGB,\r\n  
    in float strength)\r\n  {\r\n      float3 gravDir = fieldSampleRGB * 2.0 - 1.0;\r\n     
    attributes.velocity = gravDir * strength;\r\n  }"
